# Copy to .env and fill in your values: cp .env.example .env
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# headroom ML text model. "disabled" = don't download/use it (logs, JSON, code still compress).
# Leave empty to use it (needs HuggingFace access; see README for SSL issues on corporate networks).
HEADROOM_KOMPRESS_MODEL=disabled
