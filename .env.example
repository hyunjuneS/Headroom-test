# cp .env.example .env 후 값 채우기

# 실제 LLM 엔드포인트 (OpenAI 호환). headroom 프록시가 이쪽으로 요청을 전달한다.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# headroom 프록시 주소 (app/llm_call.py 가 여기로 요청을 보냄)
HEADROOM_PROXY_URL=http://127.0.0.1:8787

# 압축 모드: token(적극 압축, 기본) | cache(프롬프트 캐시 우선)
HEADROOM_MODE=token

# Kompress(텍스트 ML 압축 모델, Hugging Face 다운로드 필요) 끄기.
# 회사망에서 huggingface.co 접속이 막히면 1 로 둔다. 로그/JSON/코드 압축은 그대로 동작.
HEADROOM_DISABLE_KOMPRESS=1

# [custom] 압축된 블록마다 전략/체인/크기 변화를 로그로 출력 (vendor 코드가 실제로 도는지 확인용)
HEADROOM_CUSTOM_TRACE=1
